---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Våre tjenester"
  description="Utforsk våre tjenester innen taktekking, isolering, grytetekking, takforvaltning, taksikring og radonsperre."
>
  <main>
    <section class="page-intro">
      <div class="container">
        <nav class="intro-label" aria-label="Brødsmulesti">
          <a href="/">4Tak</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">Tjenester</span>
        </nav>
        <h1>Våre tjenester</h1>

        <h2>Ingen oppdrag er for små eller for store.</h2>

        <p class="page-intro-text">
          Vi utfører taktekking på alt fra baderom og terrasser til store
          industritak og parkeringsdekker. Med erfaring innen både synlig og
          tildekket membran leverer vi solide og varige løsninger tilpasset
          hvert enkelt prosjekt.
        </p>
      </div>
    </section>

    <section class="services services-page" id="tjenester">
      <div class="container">
        <div class="services-header">
          <h2>Dette kan vi hjelpe deg med</h2>
        </div>

        <div class="services-list">
          <article class="service-card">
            <a class="service-card-link" href="/services/taktekking">
              <div class="service-image">
                <img
                  src="/assets/images/services/4tak-tjeneste-1.png"
                  alt="Isolasjonsplater og takmaterialer på et flatt tak"
                />
              </div>

              <div class="service-content">
                <span class="service-number">01</span>
                <h3>Taktekking og isolering</h3>
                <p>Solide løsninger tilpasset bygget og behovene dine.</p>
                <span class="service-btn">
                  Les mer <span aria-hidden="true">&gt;</span>
                </span>
              </div>
            </a>
          </article>

          <article class="service-card">
            <a class="service-card-link" href="/services/grytetekking">
              <div class="service-image">
                <img
                  src="/assets/images/services/4tak-tjeneste-2.png"
                  alt="Påføring av varm asfalt på en takflate"
                />
              </div>

              <div class="service-content">
                <span class="service-number">02</span>
                <h3>Grytetekking</h3>
                <p>
                  Slitesterke og vanntette løsninger med varm asfalt for
                  langvarig beskyttelse.
                </p>
                <span class="service-btn">
                  Les mer <span aria-hidden="true">&gt;</span>
                </span>
              </div>
            </a>
          </article>

          <article class="service-card">
            <a class="service-card-link" href="/services/takforvaltning">
              <div class="service-image">
                <img
                  src="/assets/images/services/4tak-tjeneste-3.png"
                  alt="Taktekker som arbeider med membran på et flatt tak"
                />
              </div>

              <div class="service-content">
                <span class="service-number">03</span>
                <h3>Takforvaltning</h3>
                <p>
                  Vi gir eldre tak nytt liv og sørger for en løsning som varer.
                </p>
                <span class="service-btn">
                  Les mer <span aria-hidden="true">&gt;</span>
                </span>
              </div>
            </a>
          </article>

          <article class="service-card">
            <a class="service-card-link" href="/services/taksikring">
              <div class="service-image">
                <img
                  src="/assets/images/services/4tak-tjeneste-4.png"
                  alt="Flatt tak med monterte takinstallasjoner"
                />
              </div>

              <div class="service-content">
                <span class="service-number">04</span>
                <h3>Taksikring</h3>
                <p>Trygge løsninger som sikrer ferdsel og arbeid på taket.</p>
                <span class="service-btn">
                  Les mer <span aria-hidden="true">&gt;</span>
                </span>
              </div>
            </a>
          </article>

          <article class="service-card">
            <a class="service-card-link" href="/services/radonsperre">
              <div class="service-image">
                <img
                  src="/assets/images/services/4tak-tjeneste-5.png"
                  alt="Svart membran lagt utover en takflate"
                />
              </div>

              <div class="service-content">
                <span class="service-number">05</span>
                <h3>Radonsperre</h3>
                <p>
                  Effektiv beskyttelse mot radongass for et tryggere inneklima.
                </p>
                <span class="service-btn">
                  Les mer <span aria-hidden="true">&gt;</span>
                </span>
              </div>
            </a>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
