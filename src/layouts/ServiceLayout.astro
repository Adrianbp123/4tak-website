---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  breadcrumb: string;
  description: string;
  image: string;
  imageAlt: string;
  heading: string;
  paragraphs: string[];
}

const { title, breadcrumb, description, image, imageAlt, heading, paragraphs } =
  Astro.props;
---

<BaseLayout title={title} description={description}>
  <main>
    <section class="page-intro">
      <div class="container">
        <nav class="intro-label" aria-label="Brødsmulesti">
          <a href="/">4Tak</a>
          <span aria-hidden="true"> / </span>
          <a href="/services">Tjenester</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">{breadcrumb}</span>
        </nav>

        <h1>{title}</h1>

        <p class="page-intro-text">{description}</p>
      </div>
    </section>

    <section class="service-details">
      <div class="container">
        <div class="service-details-image">
          <img src={image} alt={imageAlt} />
        </div>

        <div class="service-details-content">
          <p class="intro-label">Våre løsninger</p>

          <h2>{heading}</h2>

          {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="service-contact">
      <div class="container">
        <h2>Trenger du hjelp med taket?</h2>

        <p>Ta kontakt med oss for å diskutere ditt prosjekt.</p>

        <a href="/contact" class="btn service-contact-btn">
          Kontakt oss
          <span aria-hidden="true">&gt;</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
